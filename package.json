{
  "name": "krypt-editor",
  "productName": "Krypt Editor",
  "version": "0.2.0",
  "description": "A free, no-bloat CapCut-style video editor for Windows. Cut, trim, and compose clips on a timeline. Part of the Krypt free tools suite. Based on OpenCut (MIT).",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Krypt",
    "email": "hi@krypt.cc",
    "url": "https://krypt.cc"
  },
  "homepage": "https://krypt.cc/tools/editor",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "esbuild shared/naming.ts --bundle --format=esm --platform=node --outfile=test/.naming.mjs && esbuild test/entry.editor.ts --bundle --format=esm --platform=node --alias:@shared=./shared --external:mediabunny --external:./src/editor/mediapipeFileset.ts --outfile=test/.editor.mjs && node test/naming.test.mjs && node test/editor.test.mjs",
    "dist": "npm run build && electron-builder",
    "make-ico": "node scripts/make-ico.mjs",
    "test:mcp": "esbuild test/mcp.e2e.ts --bundle --format=esm --platform=node --packages=external --outfile=test/.mcp.e2e.mjs --log-level=error && node test/.mcp.e2e.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@modelcontextprotocol/server": "^2.3.1",
    "discord-rpc": "^4.0.1",
    "mediabunny": "^1.16.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "react-resizable-panels": "^2.1.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^45.1.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "jimp": "^1.6.1",
    "lucide-react": "^0.368.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.9",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "cc.krypt.editor",
    "productName": "Krypt Editor",
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/**",
      "!node_modules/@mediapipe/**",
      "!node_modules/@img/**",
      "!node_modules/sharp/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "fileAssociations": [
      {
        "ext": "krypt",
        "name": "Krypt Project",
        "role": "Editor",
        "icon": "resources/krypt.ico"
      },
      {
        "ext": [
          "mp4",
          "mov",
          "webm",
          "m4v",
          "mkv"
        ],
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/krypt.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "installerIcon": "resources/krypt.ico",
      "uninstallerIcon": "resources/krypt.ico",
      "uninstallDisplayName": "Krypt Editor",
      "shortcutName": "Krypt Editor"
    },
    "mac": {
      "icon": "resources/krypt.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  },
  "allowScripts": {
    "electron@45.1.0": true
  }
}
